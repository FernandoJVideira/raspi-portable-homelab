arcane.{$DOMAIN} {
	tls {
		dns cloudflare {env.CF_API_TOKEN}
	}
	reverse_proxy arcane:3552
}

pihole.{$DOMAIN} {
   	tls {
   		dns cloudflare {env.CF_API_TOKEN}
   	}
   	redir / /admin/ 302
   	reverse_proxy pihole:80
}

